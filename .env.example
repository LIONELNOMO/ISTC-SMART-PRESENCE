# Variables du FUTUR serveur (Node + PostgreSQL ou Supabase).
#
# §13.8 « Secrets dans le code de l'application » : tout ce qui est préfixé par
# VITE_ est embarqué dans le JavaScript envoyé au navigateur, donc PUBLIC.
# Aucune clef, aucun secret, aucun mot de passe ne doit porter ce préfixe.
#
# Ce fichier est un modèle. Le vrai .env n'est jamais versionné.

# --- Côté navigateur : public, non sensible ---
VITE_API_URL=https://api.exemple.test

# --- Côté serveur uniquement : à ne jamais préfixer par VITE_ ---
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/presences
# SESSION_SECRET=
# VAPID_PRIVATE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
